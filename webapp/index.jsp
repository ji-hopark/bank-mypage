<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="WEB-INF/runtime.jsp" %>
<% String title="마이페이지",active="/my/";try {
JsonObject p; synchronized(application){p=state(application,"profile",seed(application,"profile")).getAsJsonObject();}JsonArray enrollments=getJson("product","/api/enrollments.jsp").getAsJsonArray("enrollments");
%>
<%@ include file="WEB-INF/header.jsp" %>
<div class="page-title"><p class="eyebrow">MY NOVA</p><h1>마이페이지</h1><p>나의 정보와 금융 생활을 편하게 관리하세요.</p></div><div class="content-grid"><div><section class="panel"><div class="person"><span class="avatar large">김</span><div><span class="pill"><%=h(p.get("tier").getAsString())%> 고객</span><h2><%=h(p.get("name").getAsString())%>님</h2><p class="muted">NOVA와 함께한 시작 · <%=h(p.get("joined").getAsString())%></p></div></div><dl class="details"><dt>휴대폰 번호</dt><dd><%=h(p.get("phone").getAsString())%></dd><dt>이메일</dt><dd><%=h(p.get("email").getAsString())%></dd><dt>나의 혜택</dt><dd>우수·프리미엄 고객 이체 수수료 면제</dd></dl></section><section class="panel section"><h2>알림 수신 설정</h2><p class="muted" data-bms-key="mypage.notice"></p><form id="preferences-form"><label class="check preference"><span><strong>이체 결과 알림</strong><small>체험 이체 완료 시 안내 문구를 표시해요.</small></span><input type="checkbox" name="notificationConsent" id="notificationConsent" <%=p.get("notificationConsent").getAsBoolean()?"checked":""%>></label><button class="button primary" type="submit">설정 저장</button><p id="preferences-message" class="message" role="status"></p></form></section></div><aside><section class="side-card"><h2>내 체험 가입 상품</h2><%if(enrollments.isEmpty()){%><p class="muted">아직 체험 가입한 상품이 없어요.</p><%}else{for(int i=enrollments.size()-1;i>=0;i--){JsonObject e=enrollments.get(i).getAsJsonObject();%><div class="enrollment"><strong><%=h(e.get("productName").getAsString())%></strong><p><%=money(e.get("amount").getAsLong())%>원 · 체험 가입</p><small class="muted"><%=h(e.get("date").getAsString())%></small></div><%}}%><a href="/products/">다른 상품 둘러보기 →</a></section><section class="side-note"><h3>이체 내역이 궁금하세요?</h3><a href="/transfers/history.jsp">내 체험 이체 내역 →</a></section></aside></div>
<script type="module" src="/my/js/mypage.js"></script>
<%@ include file="WEB-INF/footer.jsp" %>
<% }catch(Exception ex){response.setStatus(ex instanceof ApiException ? ((ApiException)ex).status:502);out.print("<!doctype html><html lang=\"ko\"><meta charset=\"utf-8\"><title>안내</title><h1>"+h(ex instanceof ApiException?ex.getMessage():"잠시 후 다시 이용해 주세요.")+"</h1><p><a href=\"/\">홈으로 이동</a></p></html>");} %>
